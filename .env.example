# ================================================================
# Enterprise RAG Configuration Template
# Copy this file to `.env` and fill in your preferred settings.
# ================================================================

# Application
APP_NAME="Enterprise RAG API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ----------------------------------------------------------------
# LLM Provider Configuration
# Options: "openai", "google", "ollama", "groq", "mock"
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ----------------------------------------------------------------
# Embedding Provider Configuration
# Options: "openai", "google", "ollama", "huggingface", "tfidf"
# ----------------------------------------------------------------
EMBEDDING_PROVIDER="tfidf"
EMBEDDING_MODEL="text-embedding-3-small"

# ----------------------------------------------------------------
# API Keys (Provide according to your selected provider)
# ----------------------------------------------------------------
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OLLAMA_BASE_URL="http://localhost:11434"

# ----------------------------------------------------------------
# Vector Database Configuration
# Options: "in_memory", "chroma", "faiss"
# ----------------------------------------------------------------
VECTOR_DB_TYPE="in_memory"
PERSIST_DIRECTORY="data/vector_store_data"

# ----------------------------------------------------------------
# Chunking & Retrieval Parameters
# ----------------------------------------------------------------
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_SCORE_THRESHOLD=0.05
